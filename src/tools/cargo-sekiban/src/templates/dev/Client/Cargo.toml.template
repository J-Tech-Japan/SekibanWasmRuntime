[package]
name = "__SEKIBAN_PROJECT_KEBAB__-client"
version = "0.1.0"
edition = "2021"

[dependencies]
anyhow = "1"
sekiban-core = { path = "../vendor/sekiban-core" }
sekiban-executor = { path = "../vendor/sekiban-executor" }
sekiban-wasm-domain = { path = "../vendor/domain" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "time"] }
uuid = { version = "1", features = ["serde", "v7"] }
