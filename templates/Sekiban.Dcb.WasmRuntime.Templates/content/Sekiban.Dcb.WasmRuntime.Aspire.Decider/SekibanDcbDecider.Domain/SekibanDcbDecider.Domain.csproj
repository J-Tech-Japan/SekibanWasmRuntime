<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>SekibanDcbDecider.Domain</RootNamespace>
    <AssemblyName>SekibanDcbDecider.Domain</AssemblyName>
    <!-- Self-contained like an external consumer: pin public package versions here
         rather than via this repo's Central Package Management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Public-consumer proof: the Decider domain depends ONLY on the public Sekiban DCB
    NuGet package, pinned to the current 10.24.2 contract line of this repository's
    runtime (the published 1.0.0-preview.7 image predates it; see CHANGELOG). No repo-local
    runtime / internalUsages / submodule-source references.
  -->
  <ItemGroup>
    <PackageReference Include="Sekiban.Dcb.WithoutResult" Version="10.24.2" />
  </ItemGroup>

</Project>
